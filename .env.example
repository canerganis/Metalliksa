# OPENAI_API_KEY: Required for GPT-6 AI API calls.
# Configure this on the server; never expose it to the browser.
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Materials Project API Key for DFT, thermodynamic hull, elastic tensor and CIF crystal structures
MATERIALS_PROJECT_API_KEY="your_materials_project_api_key_here"

# Optional host Python executable (one path, no arguments). Shell variables win.
# If blank: project .venv, active VIRTUAL_ENV, then system Python are probed.
# Invalid explicit values fail without fallback. Restart the server after changes.
# METALLIX_PYTHON="C:/path with spaces/.venv/Scripts/python.exe"
METALLIX_PYTHON=""

# Windows LPBF stays WSL-first for OpenFOAM; host fallback uses METALLIX_PYTHON.
METALLIKSA_WSL_DISTRO="Ubuntu-22.04"

# --- Persistent Python IPC daemon (internal; python/persistent_ipc_service.py) ---
# METALLIX_IPC_PORT: leave unset. The daemon binds a free loopback port and announces it to this
# server; requests are HMAC-signed with a per-spawn secret and only go to the announced port.
# A fixed port is for diagnostics only: if another process holds it, the daemon does not use it
# (Windows: the daemon exits and requests fall back to slower ad-hoc script spawns).
# METALLIX_IPC_PORT=
# METALLIX_IPC_SOCK: leave unset (POSIX). The daemon creates its socket (mode 0600) in a fresh
# 0700 directory under XDG_RUNTIME_DIR or the temp directory. An explicit path must be in a
# directory owned by this user that is not group/world-writable (a path directly in /tmp is refused).
# METALLIX_IPC_SOCK=
# METALLIX_IPC_HOST: keep the default 127.0.0.1. A non-loopback value is ignored (the supervisor
# binds 127.0.0.1 and logs a warning) unless METALLIX_IPC_ALLOW_REMOTE=1 is also set; wildcard
# addresses (0.0.0.0, ::) are never used. Remote clients must then send Host: <that address>:<port>.
# METALLIX_IPC_HOST=127.0.0.1
# METALLIX_IPC_ALLOW_REMOTE=
# METALLIX_IPC_TOKEN: do NOT set. The server generates a fresh random secret for every daemon spawn,
# passes it to the daemon through its environment and deletes any inherited value at startup.

# --- Server hardening ---
# METALLIKSA_HOST: bind address. Default 127.0.0.1 (loopback only, no login needed).
# A non-loopback value (for example 0.0.0.0) enables login mode: if METALLIKSA_TOKEN is not set,
# the server generates a random one-time access code at startup (memory only) and prints a login
# URL such as http://localhost:3000/login?code=... in the console. Opening it sets a session
# cookie (HttpOnly, SameSite=Strict, 12 h) and the code is then invalidated. The link opens a small
# page with a "Sign in" button; the code is only consumed when the button posts the form.
# METALLIKSA_HOST=127.0.0.1
# METALLIKSA_TOKEN: optional. When set, API clients may send "Authorization: Bearer <token>" and
# browsers may log in by POSTing it to /login (form field or JSON "code"). It is never accepted in a
# URL. Without it, /api/* requires either a session cookie
# (login mode) or nothing at all (loopback bind). /api/health stays reachable.
# METALLIKSA_TOKEN=
# Use HTTPS (for example a TLS reverse proxy) for any non-local use: the access code and the
# session cookie travel in clear text over plain HTTP. The Secure cookie flag is set when the
# request is https (see the trust proxy note below).
# Rate limits are keyed on req.ip. Behind a reverse proxy, Express needs "trust proxy" configured
# for req.ip to reflect the real client; otherwise all clients share the proxy address.
# The same applies to the Secure cookie flag: configure "trust proxy" so req.secure reflects X-Forwarded-Proto.
# METALLIKSA_TRUST_PROXY: off by default. Set to "true", a hop count (for example 1) or a subnet
# (for example "loopback") when behind a TLS reverse proxy. It is passed to Express "trust proxy",
# so req.secure (Secure cookie flag), req.ip (rate limits) and X-Forwarded-Host/-Proto (same-origin
# check for cookie-authenticated writes) are honoured. The proxy must forward the original host, for
# example nginx: proxy_set_header Host $host; (or X-Forwarded-Host) and X-Forwarded-Proto $scheme.
# METALLIKSA_TRUST_PROXY=
